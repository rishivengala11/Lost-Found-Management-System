<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Lost And Found Management System</display-name>
    <description>GRIET - Lost And Found Management System</description>

    <!-- Welcome File -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!-- ==================== Servlet Declarations ==================== -->

    <servlet>
        <servlet-name>ReportLostServlet</servlet-name>
        <servlet-class>com.lostandfound.servlet.ReportLostServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>ReportFoundServlet</servlet-name>
        <servlet-class>com.lostandfound.servlet.ReportFoundServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>SearchServlet</servlet-name>
        <servlet-class>com.lostandfound.servlet.SearchServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>MatchServlet</servlet-name>
        <servlet-class>com.lostandfound.servlet.MatchServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.lostandfound.servlet.DashboardServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>AdminServlet</servlet-name>
        <servlet-class>com.lostandfound.servlet.AdminServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>AuthServlet</servlet-name>
        <servlet-class>com.lostandfound.servlet.AuthServlet</servlet-class>
    </servlet>

    <!-- ==================== Servlet Mappings ==================== -->

    <servlet-mapping>
        <servlet-name>ReportLostServlet</servlet-name>
        <url-pattern>/api/lost</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>ReportFoundServlet</servlet-name>
        <url-pattern>/api/found</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>SearchServlet</servlet-name>
        <url-pattern>/api/search</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>MatchServlet</servlet-name>
        <url-pattern>/api/match</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/api/dashboard</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>AdminServlet</servlet-name>
        <url-pattern>/api/admin</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/api/auth</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>VerifyServlet</servlet-name>
        <servlet-class>com.lostandfound.servlet.VerifyServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>VerifyServlet</servlet-name>
        <url-pattern>/api/verify</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UpdateStatusServlet</servlet-name>
        <servlet-class>com.lostandfound.servlet.UpdateStatusServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>MyItemsServlet</servlet-name>
        <servlet-class>com.lostandfound.servlet.MyItemsServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>UpdateStatusServlet</servlet-name>
        <url-pattern>/api/status</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>MyItemsServlet</servlet-name>
        <url-pattern>/api/myitems</url-pattern>
    </servlet-mapping>

</web-app>
